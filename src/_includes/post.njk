<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Popunder Scripts -->
  <script>
    (function(d,z,s){
      s.src='https://'+d+'/400/'+z;
      try{ (document.body || document.documentElement).appendChild(s) }
      catch(e){}
    })('vemtoutcheeg.com', 9488588, document.createElement('script'));
  </script>
  <script>
    (function(d,z,s){
      s.src='https://'+d+'/400/'+z;
      try{ (document.body || document.documentElement).appendChild(s) }
      catch(e){}
    })('vemtoutcheeg.com', 9488646, document.createElement('script'));
  </script>

  <!-- Ezoic -->
  <script src="https://cmp.gatekeeperconsent.com/min.js" data-cfasync="false"></script>
  <script src="https://the.gatekeeperconsent.com/cmp.min.js" data-cfasync="false"></script>
  <script async src="//www.ezojs.com/ezoic/sa.min.js"></script>
  <script>
    window.ezstandalone = window.ezstandalone || {};
    ezstandalone.cmd = ezstandalone.cmd || [];
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - The Sports Scoop</title>

  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="/assets/img/favicon.png" type="image/png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <!-- Custom Responsive Featured Image -->
  <style>
    .featured-image-container {
      text-align: center;
      margin-bottom: 20px;
    }
    .featured-image {
      width: 100%;
      max-width: 350px;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: 8px;
      display: block;
      margin: 0 auto;
    }

    .related-posts {
      margin-top: 40px;
      border-top: 1px solid #ccc;
      padding-top: 20px;
    }
    .related-posts h3 {
      font-size: 1.2rem;
      margin-bottom: 15px;
    }
    .related-posts ul {
      list-style: none;
      padding: 0;
    }
    .related-posts li {
      margin-bottom: 10px;
    }
    .related-posts a {
      text-decoration: none;
      color: #007acc;
    }
  </style>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZK0L8P5WQM"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-ZK0L8P5WQM');
  </script>

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9374407582799127" crossorigin="anonymous"></script>
</head>
<body>

  {% include "header.njk" %}

  <!-- Top Ad Placeholder -->
  <div id="ezoic-pub-ad-placeholder-118" style="margin: 20px 0;"></div>

  <main class="post-content">

    <!-- Featured Image -->
    {% if image %}
      <div class="featured-image-container">
        <img src="{{ image }}" alt="{{ title }}" class="featured-image">
      </div>
    {% endif %}

    <!-- Ad Placeholder -->
    <div id="ezoic-pub-ad-placeholder-114" style="margin: 30px 0;"></div>

    <!-- Main Content -->
    {{ content | safe }}

    <!-- Mid Content Ad -->
    <div id="ezoic-pub-ad-placeholder-110" style="margin: 40px 0;"></div>

    <!-- Related Posts Section -->
    {% set fallbackTag = "football" %}
    {% if tags and tags.length > 0 %}
      {% set firstTag = tags[0] %}
    {% else %}
      {% set firstTag = fallbackTag %}
    {% endif %}

    {% set relatedPosts = (
      collections.posts
        | rejectattr("url", "equalto", page.url)
        | selectattr("data.tags", "contains", firstTag)
        | slice(0, 3)
    ) %}

    {% if relatedPosts.length > 0 %}
      <div class="related-posts">
        <h3>Related Posts</h3>
        <ul>
          {% for post in relatedPosts %}
            <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <!-- Post Content Ad -->
    <div id="ezoic-pub-ad-placeholder-114" style="margin: 30px 0;"></div>

  </main>

  <!-- Bottom Ad -->
  <div id="ezoic-pub-ad-placeholder-103" style="margin: 40px 0;"></div>

  {% include "footer.njk" %}

  <script>
    ezstandalone.cmd.push(function () {
      ezstandalone.showAds(114, 118, 103, 110);
    });
  </script>

  <script src="/assets/js/main.js"></script>
</body>
</html>
