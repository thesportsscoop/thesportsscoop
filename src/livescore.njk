<section class="livescore-section">
  <header class="livescore-header">
    <h1>⚽ Live Football Scores</h1>
    <div class="last-updated" id="last-updated"></div>
  </header>

  <div class="livescore-container">
    <div id="score-list" class="score-list">
      <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading live scores...</p>
      </div>
    </div>

    <div class="livescore-controls">
      <button id="refresh-btn" class="refresh-btn">🔄 Refresh</button>
      <div class="auto-refresh">
        <input type="checkbox" id="auto-refresh" checked>
        <label for="auto-refresh">Auto-refresh (60s)</label>
      </div>
    </div>
  </div>
</section>

<script>
  const scoreList = document.getElementById('score-list');
  const refreshBtn = document.getElementById('refresh-btn');
  const autoRefreshCheckbox = document.getElementById('auto-refresh');
  const lastUpdatedElement = document.getElementById('last-updated');

  let refreshInterval;
  const REFRESH_INTERVAL_MS = 60000;

  const formatTime = (date) => {
    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  };

  const updateLastUpdatedTime = () => {
    const now = new Date();
    lastUpdatedElement.textContent = `Last updated: ${formatTime(now)}`;
  };

  const showLoading = () => {
    scoreList.innerHTML = `
      <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading live scores...</p>
      </div>
    `;
  };

  const showError = (error) => {
    console.error('Error loading scores:', error);
    scoreList.innerHTML = `
      <div class="error-state">
        <p>❌ Failed to load scores.</p>
        <p><small>${error.message || 'Unknown error'}</small></p>
        <button onclick="loadScores()" class="retry-btn">Retry</button>
      </div>
    `;
  };

  const renderMatches = (matches) => {
    if (!matches || matches.length === 0) {
      scoreList.innerHTML = `
        <div class="no-matches">
          <p>📭 No live matches currently</p>
          <p><small>Check back later for updates</small></p>
        </div>
      `;
      return;
    }

    let html = '';
    matches.forEach(match => {
      try {
        const home = match.home;
        const away = match.away;
        const time = match.time?.minute !== undefined ? `${match.time.minute}'` : 'Live';
        const competition = match.league;

        html += `
          <div class="match-card">
            <div class="match-header">
              <span class="competition">${competition}</span>
              <span class="match-time">${time}</span>
            </div>
            <div class="match-teams">
              <div class="team home-team">
                <span class="team-name">${home.name}</span>
                <span class="team-score">${home.score}</span>
              </div>
              <div class="team away-team">
                <span class="team-name">${away.name}</span>
                <span class="team-score">${away.score}</span>
              </div>
            </div>
          </div>
        `;
      } catch (err) {
        console.error('Error rendering match:', match, err);
      }
    });

    scoreList.innerHTML = html;
  };

  const loadScores = async () => {
    showLoading();
    try {
      const response = await fetch('/.netlify/functions/livescore');
      if (!response.ok) throw new Error(`Server returned ${response.status}`);
      const data = await response.json();
      if (!data || !data.data) throw new Error('Invalid data format from server');
      renderMatches(data.data);
      updateLastUpdatedTime();
    } catch (error) {
      showError(error);
    }
  };

  const setupAutoRefresh = () => {
    if (autoRefreshCheckbox.checked) {
      refreshInterval = setInterval(loadScores, REFRESH_INTERVAL_MS);
    } else {
      clearInterval(refreshInterval);
    }
  };

  refreshBtn.addEventListener('click', loadScores);
  autoRefreshCheckbox.addEventListener('change', setupAutoRefresh);

  loadScores();
  setupAutoRefresh();
</script>

<style>
  .livescore-section {
    max-width: 800px;
    margin: 0 auto;
    padding: 1.5rem;
    font-family: 'Segoe UI', Roboto, sans-serif;
  }

  .livescore-header {
    text-align: center;
    margin-bottom: 1rem;
  }

  .last-updated {
    font-size: 0.9rem;
    color: #666;
    margin-top: 0.5rem;
  }

  .livescore-container {
    background: white;
    border-radius: 8px;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.1);
  }

  .score-list {
    min-height: 200px;
    padding: 1rem;
  }

  .loading-state, .error-state, .no-matches {
    text-align: center;
    padding: 2rem;
  }

  .spinner {
    width: 24px;
    height: 24px;
    border: 3px solid #ccc;
    border-top: 3px solid #3498db;
    border-radius: 50%;
    margin: 0 auto 1rem;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .match-card {
    padding: 1rem;
    border-bottom: 1px solid #eee;
  }

  .match-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 0.5rem;
  }

  .match-teams {
    display: flex;
    justify-content: space-between;
    font-size: 1.1rem;
    font-weight: bold;
  }

  .team {
    width: 45%;
    display: flex;
    justify-content: space-between;
  }

  .team-name {
    text-align: left;
  }

  .team-score {
    text-align: right;
  }

  .livescore-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: #f9f9f9;
    border-top: 1px solid #eee;
  }

  .refresh-btn {
    background: #3498db;
    color: white;
    border: none;
    padding: 0.4rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .refresh-btn:hover {
    background: #2980b9;
  }

  .retry-btn {
    margin-top: 1rem;
    background: #e74c3c;
    color: white;
    border: none;
    padding: 0.4rem 1rem;
    border-radius: 4px;
    cursor: pointer;
  }

  .auto-refresh {
    display: flex;
    align-items: center;
    font-size: 0.9rem;
    gap: 0.3rem;
  }

  @media (max-width: 600px) {
    .match-teams {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .team {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
