---
layout: base.njk
title: Latest News & Updates
permalink: /index.html
---

<main class="container">
    <h1 class="page-title">Welcome to The Sports Scoop!</h1>
    <p class="page-description">Your ultimate source for the freshest sports news, insights, and analysis from across the globe. Dive into the latest headlines below:</p>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-ZK0L8P5WQM"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-ZK0L8P5WQM');
</script>
    <div class="news-grid">
        {# Loop through all news posts in reverse order (newest first) #}
        {% for post in collections.news | reverse %}
        <div class="news-widget">
            <a href="{{ post.url }}">
                {% if post.data.image %}
                    <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
                {% else %}
                    <img src="/assets/images/placeholder.jpg" alt="Placeholder image for {{ post.data.title }}"> {# Fallback image #}
                {% endif %}
                <div class="news-widget-content">
                    <h3>{{ post.data.title }}</h3>
                    <p>{{ post.data.description | truncate(100, true, "...") }}</p>
                    <span class="news-widget-date">{{ post.date | dateReadable }}</span>
                </div>
            </a>
        </div>
        {% endfor %}
    </div>
</main>

<style>
    /* Page Title & Description Styling for the new homepage */
    .page-title {
        text-align: center;
        color: var(--primary-color);
        margin-top: 2rem;
        margin-bottom: 1rem;
        font-size: 2.8em; /* Slightly larger for homepage title */
        border-bottom: 2px solid var(--primary-color);
        padding-bottom: 0.5em;
        display: inline-block;
        width: auto;
        max-width: 100%;
        margin-left: auto;
        margin-right: auto;
        display: block; /* to center the inline-block element */
    }

    .page-description {
        text-align: center;
        font-size: 1.2em; /* Slightly larger for homepage intro */
        color: var(--dark-grey);
        margin-bottom: 3rem;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    /* news-grid and news-widget styles are assumed to be in your global style.css */
    /* If not, ensure these basic styles are present in style.css or copied here from previous examples */
    .news-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .news-widget {
        background-color: var(--secondary-color);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease-in-out;
    }

    .news-widget:hover {
        transform: translateY(-5px);
    }

    .news-widget a {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .news-widget img {
        width: 100%;
        height: 200px; /* Fixed height for consistency */
        object-fit: cover;
        display: block;
    }

    .news-widget-content {
        padding: 15px;
    }

    .news-widget h3 {
        margin-top: 0;
        color: var(--primary-color);
        font-size: 1.3em;
        line-height: 1.4;
        min-height: 3.2em;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .news-widget p {
        font-size: 0.95em;
        color: var(--dark-grey);
        line-height: 1.5;
        min-height: 4.5em;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .news-widget-date {
        display: block;
        font-size: 0.85em;
        color: var(--medium-grey);
        margin-top: 10px;
        text-align: right;
    }
</style>
