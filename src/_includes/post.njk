<main class="post-layout" style="display: flex; flex-wrap: wrap; gap: 30px;">

  <!-- Main Post Content -->
  <article class="main-post" style="flex: 1 1 65%;">
    {% if image %}
      <div class="featured-image-container">
        <img src="{{ image }}" alt="{{ title }}" class="featured-image">
      </div>
    {% endif %}

    <!-- Pre-content ad -->
    <div id="ezoic-pub-ad-placeholder-114" style="margin: 30px 0;"></div>

    {{ content | safe }}

    <!-- Mid/post-content ads -->
    <div id="ezoic-pub-ad-placeholder-110" style="margin: 40px 0;"></div>
    <div id="ezoic-pub-ad-placeholder-114" style="margin: 30px 0;"></div>
  </article>

  <!-- Sidebar with Related Posts -->
  <aside class="related-sidebar" style="flex: 1 1 30%;">
    <h3 style="border-bottom: 2px solid #ddd; padding-bottom: 10px;">Related Posts</h3>
    {% set tag = (tags | first) %}
    {% set relatedPosts = collections.posts | rejectattr("url", "equalto", page.url) | selectattr("data.tags", "contains", tag) | slice(0, 3) %}
    {% if relatedPosts.length %}
      <div class="related-sidebar-posts">
        {% for post in relatedPosts %}
          <div class="related-post-card" style="margin-bottom: 20px;">
            <a href="{{ post.url }}" style="text-decoration: none; color: inherit;">
              {% if post.data.image %}
                <img src="{{ post.data.image }}" alt="{{ post.data.title }}" style="width: 100%; height: 140px; object-fit: cover; border-radius: 6px; margin-bottom: 8px;">
              {% endif %}
              <h4 style="font-size: 1rem;">{{ post.data.title }}</h4>
            </a>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p>No related posts found.</p>
    {% endif %}
  </aside>
</main>
