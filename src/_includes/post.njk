<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Popunder Scripts -->
  <script>
    (function(d,z,s){
      s.src='https://'+d+'/400/'+z;
      try{ (document.body || document.documentElement).appendChild(s) }
      catch(e){}
    })('vemtoutcheeg.com', 9488588, document.createElement('script'));
  </script>
  <script>
    (function(d,z,s){
      s.src='https://'+d+'/400/'+z;
      try{ (document.body || document.documentElement).appendChild(s) }
      catch(e){}
    })('vemtoutcheeg.com', 9488646, document.createElement('script'));
  </script>

  <!-- Ezoic Privacy + Header Scripts -->
  <script src="https://cmp.gatekeeperconsent.com/min.js" data-cfasync="false"></script>
  <script src="https://the.gatekeeperconsent.com/cmp.min.js" data-cfasync="false"></script>
  <script async src="//www.ezojs.com/ezoic/sa.min.js"></script>
  <script>
    window.ezstandalone = window.ezstandalone || {};
    ezstandalone.cmd = ezstandalone.cmd || [];
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - The Sports Scoop</title>

  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="/assets/img/favicon.png" type="image/png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <!-- Custom Styles -->
  <style>
    .featured-image-container {
      text-align: center;
      margin-bottom: 20px;
    }

    .featured-image {
      width: 50%;
      max-width: 200px;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: 8px;
      display: block;
      margin: 0 auto;
    }

    .post-layout {
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
    }

    .main-post {
      flex: 1 1 65%;
    }

    .related-sidebar {
      flex: 1 1 30%;
    }

    .related-sidebar h3 {
      border-bottom: 2px solid #ddd;
      padding-bottom: 10px;
      margin-bottom: 20px;
    }

    .related-post-card {
      margin-bottom: 20px;
    }

    .related-post-card img {
      width: 100%;
      height: 140px;
      object-fit: cover;
      border-radius: 6px;
      margin-bottom: 8px;
    }

    .related-post-card h4 {
      font-size: 1rem;
    }

    @media (max-width: 768px) {
      .post-layout {
        flex-direction: column;
      }

      .main-post, .related-sidebar {
        flex: 1 1 100%;
      }

      .related-sidebar {
        margin-top: 40px;
      }
    }
  </style>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZK0L8P5WQM"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-ZK0L8P5WQM');
  </script>

  <!-- AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9374407582799127" crossorigin="anonymous"></script>
</head>
<body>

  {% include "header.njk" %}

  <!-- Top Ad -->
  <div id="ezoic-pub-ad-placeholder-118" style="margin: 20px 0;"></div>

  <!-- Post & Sidebar Layout -->
  <main class="post-layout">

    <!-- Main Post Content -->
    <article class="main-post">
      {% if image %}
        <div class="featured-image-container">
          <img src="{{ image }}" alt="{{ title }}" class="featured-image">
        </div>
      {% endif %}

      <!-- Ads -->
      <div id="ezoic-pub-ad-placeholder-114" style="margin: 30px 0;"></div>

      {{ content | safe }}

      <div id="ezoic-pub-ad-placeholder-110" style="margin: 40px 0;"></div>
      <div id="ezoic-pub-ad-placeholder-114" style="margin: 30px 0;"></div>
    </article>

    <!-- Related Posts Sidebar -->
    <aside class="related-sidebar">
      <h3>Related Posts</h3>
      {% set fallbackTag = "football" %}
      {% set firstTag = (tags and tags.length > 0) ? tags[0] : fallbackTag %}
      {% set relatedPosts = collections.posts 
          | rejectattr("url", "equalto", page.url)
          | selectattr("data.tags", "contains", firstTag)
          | slice(0, 3) %}

      {% if relatedPosts.length %}
        {% for post in relatedPosts %}
          <div class="related-post-card">
            <a href="{{ post.url }}" style="text-decoration: none; color: inherit;">
              {% if post.data.image %}
                <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
              {% endif %}
              <h4>{{ post.data.title }}</h4>
            </a>
          </div>
        {% endfor %}
      {% else %}
        <p>No related posts available.</p>
      {% endif %}
    </aside>
  </main>

  <!-- Bottom Ad -->
  <div id="ezoic-pub-ad-placeholder-103" style="margin: 40px 0;"></div>

  {% include "footer.njk" %}

  <script>
    ezstandalone.cmd.push(function () {
      ezstandalone.showAds(114, 118, 103, 110);
    });
  </script>

  <script src="/assets/js/main.js"></script>
</body>
</html>
