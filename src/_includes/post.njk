<!DOCTYPE html>
<html lang="en">
<head>

  <!-- Ezoic Privacy Scripts -->
  <script src="https://cmp.gatekeeperconsent.com/min.js" data-cfasync="false"></script>
  <script src="https://the.gatekeeperconsent.com/cmp.min.js" data-cfasync="false"></script>

  <!-- Ezoic Header Script -->
  <script async src="//www.ezojs.com/ezoic/sa.min.js"></script>
  <script>
    window.ezstandalone = window.ezstandalone || {};
    ezstandalone.cmd = ezstandalone.cmd || [];
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - The Sports Scoop</title>

  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="/assets/img/favicon.png" type="image/png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <!-- Custom style for responsive featured image -->
  <style>
    .featured-image-container {
      text-align: center;
      margin-bottom: 20px;
    }
    .featured-image {
      width: 50%;
      max-width: 200px;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: 8px;
      display: block;
      margin: 0 auto;
    }
  </style>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZK0L8P5WQM"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-ZK0L8P5WQM');
  </script>

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9374407582799127" crossorigin="anonymous"></script>
</head>
<body>

  {% include "header.njk" %}

  <!-- Ezoic Placeholder: Top Banner (ID: 118) -->
  <div id="ezoic-pub-ad-placeholder-118" style="margin: 20px 0;"></div>

  <main class="post-content">

    <!-- Featured Image -->
    {% if image %}
      <div class="featured-image-container">
        <img src="{{ image }}" alt="{{ title }}" class="featured-image">
      </div>
    {% endif %}

    <!-- Ezoic Placeholder: Pre-Content (ID: 114) -->
    <div id="ezoic-pub-ad-placeholder-114" style="margin: 30px 0;"></div>

    {{ content | safe }}

    <!-- Ezoic Placeholder: Mid-Content (ID: 110) -->
    <div id="ezoic-pub-ad-placeholder-110" style="margin: 40px 0;"></div>

    <!-- Ezoic Placeholder: Post-Content (Another 114) -->
    <div id="ezoic-pub-ad-placeholder-114" style="margin: 30px 0;"></div>
  </main>

  <!-- Social Sharing Buttons -->
  <div class="social-sharing" style="text-align: center; margin: 30px 0;">
    <h3>Share this post</h3>
    <div class="share-buttons" style="display: flex; justify-content: center; gap: 10px; margin-top: 15px;">
      <!-- Facebook -->
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ page.url | url | absoluteUrl }}" 
         target="_blank" 
         rel="noopener noreferrer"
         class="share-button facebook"
         style="background: #3b5998; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none;">
        <i class="fab fa-facebook"></i> Share
      </a>
      
      <!-- Twitter -->
      <a href="https://twitter.com/intent/tweet?url={{ page.url | url | absoluteUrl }}&text={{ title | urlencode }}" 
         target="_blank" 
         rel="noopener noreferrer"
         class="share-button twitter"
         style="background: #1DA1F2; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none;">
        <i class="fab fa-twitter"></i> Tweet
      </a>
      
      <!-- LinkedIn -->
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ page.url | url | absoluteUrl }}" 
         target="_blank" 
         rel="noopener noreferrer"
         class="share-button linkedin"
         style="background: #0077B5; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none;">
        <i class="fab fa-linkedin"></i> Share
      </a>
    </div>
  </div>

  <!-- Comment Section -->
  <div id="disqus_thread" style="max-width: 800px; margin: 0 auto; padding: 0 20px;"></div>
  <script>
    (function() {
      var d = document, s = d.createElement('script');
      s.src = 'https://thesportsscoop.disqus.com/embed.js';
      s.setAttribute('data-timestamp', +new Date());
      (d.head || d.body).appendChild(s);
    })();
  </script>
  <noscript>Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>

  <!-- Ezoic Placeholder: Bottom Ad (ID: 103) -->
  <div id="ezoic-pub-ad-placeholder-103" style="margin: 40px 0;"></div>

  {% include "footer.njk" %}

  <script>
    ezstandalone.cmd.push(function () {
      ezstandalone.showAds(114, 118, 103, 110);
    });
  </script>

  <script src="/assets/js/main.js"></script>
</body>
</html>
