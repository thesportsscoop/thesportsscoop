  <section class="contact-form-section my-24">
    <h2 class="text-center text-3xl font-bold mb-6">Send Us a Message</h2>
    <p class="text-center mb-10 text-gray-600 text-lg">Fill out the form below, and we’ll get back to you within 24–48 hours.</p>

    <form class="contact-form max-w-2xl mx-auto bg-red-50 p-10 rounded-3xl shadow-2xl border border-red-100" action="#" method="POST" data-netlify="true">
      <div class="form-group mb-6">
        <label for="name" class="block font-semibold mb-2">Full Name</label>
        <input type="text" id="name" name="name" class="w-full border border-gray-300 p-4 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-400" placeholder="Enter your full name" required>
