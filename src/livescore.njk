---
layout: base.njk
title: Live Scores
---

<section class="livescore-section">
  <h1>⚽ Live Football Scores</h1>
  <div id="score-list">Loading scores...</div>
</section>

<script>
  async function loadScores() {
    try {
      const res = await fetch('/.netlify/functions/livescore');
      const data = await res.json();
      const container = document.getElementById('score-list');
      container.innerHTML = '';

      if (data.data && data.data.length > 0) {
        data.data.forEach(match => {
          const home = match.participants.find(p => p.meta.location === 'home');
          const away = match.participants.find(p => p.meta.location === 'away');
          const time = match.time?.minute ? `${match.time.minute}'` : 'Live';

          container.innerHTML += `
            <div class="match">
              <strong>${home.name}</strong> ${home.scores.score} - ${away.scores.score} <strong>${away.name}</strong>
              <br><small>${time}</small>
            </div>
          `;
        });
      } else {
        container.innerHTML = '<p>No live matches at the moment.</p>';
      }
    } catch (err) {
      console.error(err);
      document.getElementById('score-list').innerHTML = '<p>Error loading scores.</p>';
    }
  }

  // Auto-refresh every 60 seconds
  setInterval(loadScores, 60000);
  // Initial load
  loadScores();
</script>

<style>
  .livescore-section {
    text-align: center;
    padding: 2rem;
  }

  #score-list .match {
    padding: 1rem;
    border-bottom: 1px solid #ddd;
    font-size: 1.1rem;
  }
</style>
