---
layout: base.njk
title: Home
---

<div class="container">
    <h1>Latest Sports News</h1>
    <section class="latest-news">
        <div class="news-grid">
            {% for post in collections.news | reverse | limit(4) %}
            <div class="news-widget">
                <a href="{{ post.url }}">
                    <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
                    <div class="news-widget-content">
                        <h3>{{ post.data.title }}</h3>
                        <p>{{ post.data.description | truncate(100, true, "...") }}</p>
                    </div>
                </a>
            </div>
            {% endfor %}
        </div>
    </section>

    <section class="category-section">
        <h2>Football News</h2>
        <div class="news-grid">
            {% for post in collections.news | reverse %}
                {% if post.data.category == "football" %}
                <div class="news-widget">
                    <a href="{{ post.url }}">
                        <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
                        <div class="news-widget-content">
                            <h3>{{ post.data.title }}</h3>
                            <p>{{ post.data.description | truncate(100, true, "...") }}</p>
                        </div>
                    </a>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </section>

    <section class="category-section">
        <h2>Basketball News</h2>
        <div class="news-grid">
            {% for post in collections.news | reverse %}
                {% if post.data.category == "basketball" %}
                <div class="news-widget">
                    <a href="{{ post.url }}">
                        <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
                        <div class="news-widget-content">
                            <h3>{{ post.data.title }}</h3>
                            <p>{{ post.data.description | truncate(100, true, "...") }}</p>
                        </div>
                    </a>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </section>

    </div>