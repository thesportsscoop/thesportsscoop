---
layout: base.njk
title: Home
---

<div class="container">
    <h1>Latest Sports News</h1>
    
    <section class="latest-news">
        <div class="news-grid">
            {% set filteredPosts = collections.news 
                | reverse 
                | reject(post => 
                    (post.data and post.data.category is string and post.data.category == "betting-tips") or
                    (post.data and post.data.category is iterable and post.data.category.includes("betting-tips"))
                ) 
                | limit(4) 
            %}

            {% for post in filteredPosts %}
            {% if post.data %}
            <div class="news-widget">
                <a href="{{ post.url }}">
                    <img src="{{ post.data.image or '/placeholder.jpg' }}" alt="{{ post.data.title or 'No title' }}">
                    <div class="news-widget-content">
                        <h3>{{ post.data.title or 'Untitled' }}</h3>
                        <p>{{ post.data.description | truncate(100, true, "...") }}</p>
                    </div>
                </a>
            </div>
            {% endif %}
            {% endfor %}
        </div>
    </section>

    <section class="category-section">
        <h2>Football News</h2>
        <div class="news-grid">
            {% for post in collections.news | reverse %}
                {% if post.data and (post.data.category == "football" or (post.data.category is iterable and post.data.category.includes("football"))) %}
                <div class="news-widget">
                    <a href="{{ post.url }}">
                        <img src="{{ post.data.image or '/placeholder.jpg' }}" alt="{{ post.data.title or 'No title' }}">
                        <div class="news-widget-content">
                            <h3>{{ post.data.title or 'Untitled' }}</h3>
                            <p>{{ post.data.description | truncate(100, true, "...") }}</p>
                        </div>
                    </a>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </section>

    <section class="category-section">
        <h2>Basketball News</h2>
        <div class="news-grid">
            {% for post in collections.news | reverse %}
                {% if post.data and (post.data.category == "basketball" or (post.data.category is iterable and post.data.category.includes("basketball"))) %}
                <div class="news-widget">
                    <a href="{{ post.url }}">
                        <img src="{{ post.data.image or '/placeholder.jpg' }}" alt="{{ post.data.title or 'No title' }}">
                        <div class="news-widget-content">
                            <h3>{{ post.data.title or 'Untitled' }}</h3>
                            <p>{{ post.data.description | truncate(100, true, "...") }}</p>
                        </div>
                    </a>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </section>

</div>
