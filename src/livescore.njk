<script>
  async function loadScores() {
    const container = document.getElementById('score-list');
    container.innerHTML = '<div class="loading">Loading scores...</div>';

    try {
      const res = await fetch('/.netlify/functions/livescore');
      
      if (!res.ok) {
        throw new Error(`Request failed with status ${res.status}`);
      }

      const data = await res.json();
      container.innerHTML = '';

      if (!data || !data.data || data.data.length === 0) {
        container.innerHTML = '<p>No live matches at the moment.</p>';
        return;
      }

      data.data.forEach(match => {
        try {
          const home = match.participants.find(p => p.meta.location === 'home');
          const away = match.participants.find(p => p.meta.location === 'away');
          const time = match.time?.minute ? `${match.time.minute}'` : 'Live';

          if (!home || !away) {
            console.warn('Missing team data for match:', match);
            return;
          }

          const matchElement = document.createElement('div');
          matchElement.className = 'match';
          matchElement.innerHTML = `
            <strong>${home.name}</strong> ${home.scores?.score || '0'} - ${away.scores?.score || '0'} <strong>${away.name}</strong>
            <br><small>${time}</small>
          `;
          container.appendChild(matchElement);
        } catch (err) {
          console.error('Error processing match:', match, err);
        }
      });
    } catch (err) {
      console.error('Failed to load scores:', err);
      container.innerHTML = `
        <p class="error">Error loading scores. Please try again later.</p>
        <button onclick="loadScores()">Retry</button>
      `;
    }
  }

  // Initial load
  loadScores();
  // Auto-refresh every 60 seconds
  setInterval(loadScores, 60000);
</script>

<style>
  .livescore-section {
    text-align: center;
    padding: 2rem;
  }

  .loading, .error {
    color: #666;
    padding: 1rem;
  }

  #score-list .match {
    padding: 1rem;
    margin: 0.5rem 0;
    border-radius: 4px;
    background: #f8f8f8;
    font-size: 1.1rem;
  }

  button {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  button:hover {
    background: #0056b3;
  }
</style>
