---
layout: base.njk
title: Latest News & Updates
permalink: /index.html
---

<main class="container">
  <h1 class="page-title">Welcome to The Sports Scoop!</h1>
  <p class="page-description">
    Your ultimate source for the freshest sports news, insights, and analysis from across the globe.
    Dive into the latest headlines below:
  </p>

  <!-- Ezoic Ad Placeholder: Homepage mid-content -->
  <div id="ezoic-pub-ad-placeholder-102" style="margin: 30px 0;"></div>

  <div class="news-grid">
    {% for post in collections.news | reverse %}
    <div class="news-widget">
      <a href="{{ post.url }}">
        {% if post.data.image %}
          <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
        {% else %}
          <img src="/assets/images/placeholder.jpg" alt="Placeholder image for {{ post.data.title }}">
        {% endif %}
        <div class="news-widget-content">
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.description | truncate(100, true, "...") }}</p>
          <span class="news-widget-date">{{ post.date | dateReadable }}</span>
        </div>
      </a>
    </div>
    {% endfor %}
  </div>
</main>
